{
  "name": "board-race",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Landscape-first cel-shaded arcade boat racing with drift-to-flight challenges.",
  "scripts": {
    "verify:rider": "node harness/rider.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "shot": "node harness/screenshot.mjs",
    "verify:smoke": "node harness/screenshot.mjs --verify-smoke",
    "verify:collision": "node harness/collision.mjs",
    "verify:audio": "node harness/audio.mjs",
    "verify:team": "node harness/team.mjs",
    "release:checked": "bash scripts/release-checked.sh"
  },
  "dependencies": {
    "@pixiv/three-vrm-springbone": "3.5.5",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "playwright": "^1.62.1",
    "typescript": "~5.9.3",
    "vite": "^8.2.1"
  }
}
